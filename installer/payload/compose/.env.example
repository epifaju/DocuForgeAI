# DocuForge AI — environment template (Phase 21 / MVP + U0 + Windows self-host)
# Copy to .env:
#   PowerShell:  Copy-Item .env.example .env
#   Bash:        cp .env.example .env
# Then secure:
#   powershell -File .\scripts\secure-env.ps1 -Show
#   powershell -File .\scripts\secure-env.ps1 -Prod -Show
# Never commit .env (see .gitignore).

# --- Runtime mode ------------------------------------------------------------
APP_ENV=development
# Public URL of the UI (links in emails, cookies context). Example LAN:
# APP_BASE_URL=http://192.168.1.10:5174
APP_BASE_URL=http://localhost:5174

# Optional Compose profiles (comma-separated). Examples: ai | ai,antivirus | proxy
# COMPOSE_PROFILES=ai

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=docuforge
POSTGRES_USER=docuforge
# REPLACE via scripts/secure-env.ps1 (-RotatePostgres / -Prod) before any shared/prod use
POSTGRES_PASSWORD=changeme_postgres_dev_only
POSTGRES_PORT=5434

# --- Host ports (self-host léger ; retirés si docker-compose.prod.yml + Traefik) ---
BACKEND_PORT=18081
FRONTEND_PORT=5174

# --- Auth / JWT --------------------------------------------------------------
# REPLACE via scripts/secure-env.* (min 32 chars; script generates 48+ bytes)
JWT_SECRET=changeme_generate_a_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# --- File storage ------------------------------------------------------------
# Inside container path (do not change unless you know why)
STORAGE_ROOT=/storage
# Compose volume source for backend /storage:
#   storage_data  = named Docker volume (recommended on Windows / WSL2)
#   ./storage     = bind mount (needed by scripts/backup.ps1 & restore.ps1 as-is)
STORAGE_VOLUME=storage_data
# Used only by backup/restore scripts when using a host bind mount
STORAGE_HOST_DIR=./storage
MAX_UPLOAD_SIZE_MB=100

BACKUP_DIR=./backups
POSTGRES_CONTAINER=docuforge-postgres

# --- PDF / LibreOffice (required for PDF conversion) -------------------------
PDF_CONVERSION_ENABLED=true
LIBREOFFICE_URL=http://libreoffice:8081
LIBREOFFICE_UNO_PORT=2002
LIBREOFFICE_UNO_HOST_PORT=2002
LIBREOFFICE_HEALTH_PORT=8081
LIBREOFFICE_HEALTH_HOST_PORT=8081
PDF_CONVERSION_TIMEOUT=60
PDF_CONVERSION_MAX_RETRIES=1

# --- AI (optional) -----------------------------------------------------------
# Keep AI_ENABLED=false unless Ollama is started: docker compose --profile ai up -d
AI_ENABLED=false
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
AI_TIMEOUT_SECONDS=60
OLLAMA_PORT=11435

# --- SMTP (Mailpit by default on the compose network) ------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@docuforge.local
SMTP_ENABLED=true
SMTP_MAX_ATTACHMENT_BYTES=26214400
MAILPIT_UI_PORT=8028
MAILPIT_SMTP_PORT=1028

BATCH_MAX_ROWS=500

# --- Antivirus (optional --profile antivirus) --------------------------------
ANTIVIRUS_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_FORGOT_PASSWORD_PER_MINUTE=5

AUTH_COOKIES_ENABLED=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# Business Packs (DBPF-1)
DOCUFORGE_PACKS_ENABLED=true
PACK_MAX_UPLOAD_SIZE_MB=100
PACK_MAX_UNCOMPRESSED_SIZE_MB=250
PACK_MAX_FILES=500
PACK_MAX_TEMPLATES=100
PACK_MAX_SINGLE_FILE_MB=25
PACK_MAX_COMPRESSION_RATIO=50
PACK_IMPORT_RETENTION_HOURS=24
PACK_PLATFORM_VERSION=0.1.0

DEFAULT_TIMEZONE=Europe/Paris

# --- First-boot bootstrap (disable after first admin exists) ------------------
DOCUFORGE_BOOTSTRAP_ENABLED=true
DOCUFORGE_BOOTSTRAP_COMPANY_NAME=DocuForge Demo
DOCUFORGE_BOOTSTRAP_COMPANY_IDENTIFIER=demo
DOCUFORGE_BOOTSTRAP_ADMIN_EMAIL=admin@demo.local
# REPLACE via scripts/secure-env.*
DOCUFORGE_BOOTSTRAP_ADMIN_PASSWORD=changeme_admin_dev_only
DOCUFORGE_BOOTSTRAP_ADMIN_FIRST_NAME=Admin
DOCUFORGE_BOOTSTRAP_ADMIN_LAST_NAME=Demo

# --- U0 / Traefik (profile proxy) --------------------------------------------
DOCUFORGE_DOMAIN=localhost
TLS_MODE=acme
ACME_EMAIL=admin@example.com
TRAEFIK_CERT_RESOLVER=le
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# Optional update manifest for the Windows tray "Vérifier les mises à jour"
# DOCUFORGE_UPDATE_URL=https://example.com/docuforge/update-manifest.json
