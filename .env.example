# DocuForge AI — environment template (Phase 21 / MVP + U0)
# Copy to .env:  cp .env.example .env
# Then secure:   powershell -File .\scripts\secure-env.ps1 -Show
#                ./scripts/secure-env.sh --show
# Prod-like:     powershell -File .\scripts\secure-env.ps1 -Prod -Show
# Never commit .env (see .gitignore).

APP_ENV=development
APP_BASE_URL=http://localhost:5174

POSTGRES_DB=docuforge
POSTGRES_USER=docuforge
# REPLACE via scripts/secure-env.ps1 (-RotatePostgres / -Prod) before any shared/prod use
POSTGRES_PASSWORD=changeme_postgres_dev_only
POSTGRES_PORT=5434

BACKEND_PORT=18081
FRONTEND_PORT=5174

# REPLACE via scripts/secure-env.* (min 32 chars; script generates 48+ bytes)
JWT_SECRET=changeme_generate_a_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

STORAGE_ROOT=/storage
STORAGE_HOST_DIR=./storage
MAX_UPLOAD_SIZE_MB=25

BACKUP_DIR=./backups
POSTGRES_CONTAINER=docuforge-postgres

PDF_CONVERSION_ENABLED=true
LIBREOFFICE_URL=http://libreoffice:8081
LIBREOFFICE_UNO_PORT=2002
LIBREOFFICE_UNO_HOST_PORT=2002
LIBREOFFICE_HEALTH_PORT=8081
LIBREOFFICE_HEALTH_HOST_PORT=8081
PDF_CONVERSION_TIMEOUT=60
PDF_CONVERSION_MAX_RETRIES=1

AI_ENABLED=false
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
AI_TIMEOUT_SECONDS=60

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@docuforge.local
SMTP_ENABLED=true
SMTP_MAX_ATTACHMENT_BYTES=26214400

BATCH_MAX_ROWS=500

ANTIVIRUS_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_FORGOT_PASSWORD_PER_MINUTE=5

AUTH_COOKIES_ENABLED=true
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

DEFAULT_TIMEZONE=Europe/Paris

MAILPIT_UI_PORT=8028
MAILPIT_SMTP_PORT=1028
OLLAMA_PORT=11435

# Dev bootstrap — disable after first admin exists (DOCUFORGE_BOOTSTRAP_ENABLED=false)
DOCUFORGE_BOOTSTRAP_ENABLED=true
DOCUFORGE_BOOTSTRAP_COMPANY_NAME=DocuForge Demo
DOCUFORGE_BOOTSTRAP_COMPANY_IDENTIFIER=demo
DOCUFORGE_BOOTSTRAP_ADMIN_EMAIL=admin@demo.local
# REPLACE via scripts/secure-env.*
DOCUFORGE_BOOTSTRAP_ADMIN_PASSWORD=changeme_admin_dev_only
DOCUFORGE_BOOTSTRAP_ADMIN_FIRST_NAME=Admin
DOCUFORGE_BOOTSTRAP_ADMIN_LAST_NAME=Demo

# --- U0 / Traefik (profile proxy) -------------------------------------------
# Public hostname for Host() router rules
DOCUFORGE_DOMAIN=localhost
# acme = Let's Encrypt (default); file = certs/fullchain.pem + privkey.pem
TLS_MODE=acme
ACME_EMAIL=admin@example.com
# Use "le" for ACME. For file TLS leave empty and use docker-compose.tls-file.yml
TRAEFIK_CERT_RESOLVER=le
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
